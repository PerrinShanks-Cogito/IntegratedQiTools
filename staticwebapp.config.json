{
  "trailingSlash": "auto",
  "routes": [
    { "route": "/gage_rr", "redirect": "/gauge_rr/", "statusCode": 301 },
    { "route": "/gage_rr/*", "redirect": "/gauge_rr/", "statusCode": 301 },
    { "route": "/p_chart", "redirect": "/spc_tool/?type=p", "statusCode": 301 },
    { "route": "/p_chart/*", "redirect": "/spc_tool/?type=p", "statusCode": 301 }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html",
      "statusCode": 404
    }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Frame-Options": "SAMEORIGIN"
  },
  "mimeTypes": {
    ".json": "application/json"
  }
}
